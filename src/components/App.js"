import React, { useState } from "react";

const App = () => {
  const [pincode, setPincode] = useState("");
  const [filterText, setFilterText] = useState("");
  const [postOffices, setPostOffices] = useState([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState("");
  const [searched, setSearched] = useState(false);

  const handleLookup = (e) => {
    e.preventDefault();
    setError("");
    setPostOffices([]);
    setFilterText("");
    setSearched(false);

    if (!/^\d{6}$/.test(pincode)) {
      setError("Please enter a valid 6-digit pincode");
      return;
    }

    setLoading(true);
    fetch(`https://api.postalpincode.in/pincode/${pincode}`)
      .then((res) => res.json())
      .then((data) => {
        setLoading(false);
        setSearched(true);
        if (data && data[0] && data[0].Status === "Success") {
          setPostOffices(data[0].PostOffice || []);
        } else {
          setError(
            (data && data[0] && data[0].Message) ||
              "No records found for this pincode"
          );
        }
      })
      .catch(() => {
        setLoading(false);
        setSearched(true);
        setError("Something went wrong while fetching the data");
      });
  };

  const filteredOffices = postOffices.filter((office) =>
    office.Name.toLowerCase().includes(filterText.toLowerCase())
  );

  return (
    <div className="app-container">
      <h1>Pincode Lookup</h1>

      <form onSubmit={handleLookup} className="lookup-form">
        <input
          type="text"
          id="pincode-input"
          placeholder="Enter 6-digit pincode"
          value={pincode}
          onChange={(e) => setPincode(e.target.value)}
        />
        <button type="submit" id="lookup-btn">
          Lookup
        </button>
      </form>

      {error && <p className="error-message">{error}</p>}

      {loading && <div className="loader" id="loader"></div>}

      {!loading && postOffices.length > 0 && (
        <div className="filter-section">
          <input
            type="text"
            id="filter-input"
            placeholder="Filter by post office name"
            value={filterText}
            onChange={(e) => setFilterText(e.target.value)}
          />
        </div>
      )}

      {!loading && searched && postOffices.length > 0 && (
        <div className="results">
          {filteredOffices.length === 0 ? (
            <p className="empty-message">
              Couldn't find the postal data you're looking for...
            </p>
          ) : (
            filteredOffices.map((office, index) => (
              <div className="post-office-card" key={index}>
                <p>
                  <strong>Post Office:</strong> {office.Name}
                </p>
                <p>
                  <strong>Pincode:</strong> {office.Pincode}
                </p>
                <p>
                  <strong>District:</strong> {office.District}
                </p>
                <p>
                  <strong>State:</strong> {office.State}
                </p>
              </div>
            ))
          )}
        </div>
      )}
    </div>
  );
};

export default App;
